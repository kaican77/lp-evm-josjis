# Robinhood LP Bot v2
# Copy ke .env, isi, jangan commit.

# ─── Wajib ───
RH_RPC_URL=          # Alchemy app → chain Robinhood → HTTPS URL
RH_WALLET_KEY=       # Burner wallet! Bukan wallet utama.
RH_TG_TOKEN=         # @BotFather → /newbot
RH_TG_CHAT=          # @userinfobot → ID lu (wajib, biar gak semua orang bisa kontrol)

# ─── Opsional ───
RH_WATCH_RPC_URL=    # RPC terpisah buat scanner (quota gak numpuk)
RH_FAST_SUBMIT=1     # kirim tx langsung ke sequencer
RH_OPENROUTER_KEY=   # LLM radar skoring token
RH_KRYSTAL_KEY=      # PnL cross-check Krystal Cloud
